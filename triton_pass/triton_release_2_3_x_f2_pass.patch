+def TritonGPUF2SharedLayout : Pass<"tritongpu-f2-shared-layout", "mlir::ModuleOp"> {
+  let summary = "Rewrite Triton shared-memory encodings using an F2 swizzle search";
+
+  let description = [{
+    Walk Triton GPU IR, find tensors encoded with `#triton_gpu.shared`, infer
+    the logical 2-D tile carried by the shared layout, run an F2 swizzle search
+    constrained to Triton's shared encoding parameterization, and rewrite the
+    shared encoding attributes in-place.
+
+    The pass updates `perPhase`, `maxPhase`, and preserves `vec`, `order`,
+    `CTALayout`, and `hasLeadingOffset`, so the output remains valid TTGIR and
+    can be printed directly by `triton-opt`.
+  }];
+
+  let constructor = "mlir::createTritonGPUF2SharedLayoutPass()";
+
+  let dependentDialects = ["mlir::triton::gpu::TritonGPUDialect",
+                           "mlir::triton::TritonDialect",
+                           "mlir::scf::SCFDialect"];
+
+  let options = [
+    Option<"maxSwizzleBits", "f2-max-swizzle-bits",
+           "int32_t", /*default=*/"3",
+           "Maximum B/M search range explored by the Triton-representable F2 search">,
+    Option<"emitRemarks", "f2-emit-remarks",
+           "bool", /*default=*/"true",
+           "Emit pass remarks describing the chosen shared-memory parameters">
+  ];
+}
+
 #endif
